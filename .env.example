DISCORD_WEBHOOK_URL=
# Optional: Irish Jooble official API key, requested from https://ie.jooble.org/api/about
JOOBLE_API_KEY=

# New Discord channel webhooks; each must be created in Discord
DISCORD_WEBHOOK_LOCAL=
DISCORD_WEBHOOK_ATS=

# PC-hosted bot: keep the real token only in your local .env.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated IDs for job-alerts, job-alerts-cork, apply-now.
DISCORD_MONITORED_CHANNEL_IDS=
# Only these users may record application clicks (normally your own user ID).
DISCORD_ALLOWED_USER_IDS=
# Optional: existing jobs-applied-for channel ID. Otherwise the bot creates it.
DISCORD_APPLIED_CHANNEL_ID=
